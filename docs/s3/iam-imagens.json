{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TakeTooImageObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::taketoo/imagens/*"
    },
    {
      "Sid": "TakeTooBucketMetadata",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::taketoo"
    }
  ]
}
